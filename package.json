{
  "name": "ghostclick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoC: drive headless Chrome from a small DSL, stream it to a canvas, draw a synthetic cursor over it. The backend; the UI is web/ (see docs/BOUNDARY.md).",
  "scripts": {
    "app": "node scripts/app.js",
    "start": "node scripts/start.js",
    "serve": "node server.js",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "check": "node scripts/check.js",
    "check:freshness": "node scripts/check-freshness.js",
    "check:runner": "node scripts/check-runner.js",
    "check:suites": "node scripts/check-suites.js",
    "check:recording": "node scripts/check-recording.js",
    "check:longnames": "node scripts/check-longnames.js",
    "check:redirects": "node scripts/check-redirects.js",
    "check:patience": "node scripts/check-patience.js",
    "check:console": "node scripts/check-console.js",
    "check:vocabulary": "node scripts/check-vocabulary.js",
    "check:startup": "node scripts/check-startup.js",
    "check:deploy": "node scripts/check-deploy.js",
    "check:icons": "node scripts/check-icons.js",
    "check:diagram": "node scripts/check-diagram.js",
    "check:teach": "node scripts/check-teach.js",
    "check:shared": "node scripts/check-shared.js",
    "check:fidelity": "node scripts/check-fidelity.js",
    "check:boundary": "node scripts/check-boundary.js",
    "sync:lang": "node scripts/sync-lang.js",
    "check:all": "npm run check && npm run check:app && npm run check:freshness && npm run check:runner && npm run check:suites && npm run check:recording && npm run check:longnames && npm run check:naming && npm run check:redirects && npm run check:patience && npm run check:pace && npm run check:console && npm run check:vocabulary && npm run check:startup && npm run check:deploy && npm run check:icons && npm run check:auth && npm run check:teach && npm run check:shared && npm run check:boundary && npm run check:diagram && npm run check:fidelity",
    "check:auth": "node scripts/check-auth.js",
    "check:naming": "node scripts/check-naming.js",
    "check:pace": "node scripts/check-pace.js",
    "check:app": "node scripts/check-app.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mermaid": "^11.4.0",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  }
}
