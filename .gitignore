node_modules/
*.log

.ghostclick/

# The Vue build is NOT committed. It used to be, so that `npm start` needed no
# bundler — and the cost was that every change to a component arrived in review
# as itself plus a wall of regenerated minified bundles, and that two people
# building the same source produced a diff.
#
# `npm start` builds it when it is missing or stale, which is what made the
# committed copy redundant. A checkout with no node_modules cannot build, and
# says so rather than serving something silently wrong.
web/dist/
web/node_modules/

# Suites the checks create. Real ones belong in git — that is the point of
# suites/ — but a check that leaves "Check console other" behind puts an
# untracked file in every `git status` forever, and noise you learn to scroll
# past is how a real change gets committed without being read.
suites/check-*.json
suites/*/check-*.json
# The tenancy check signs tokens for organisations of its own; their
# directories are removed when it ends, and ignored in case it does not.
suites/check-*/

# Deployment. The PEM authenticates to the host; .env.prod holds the shared
# auth key and Django's signing key. Neither has any business in a repository,
# and the deploy script expects the PEM at the root — so the rule has to exist
# before anyone puts it there.
*.pem
.env.prod
