# Copy to .env.prod on the host and fill in. Never committed.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# See docs/DEPLOY.md. The two things that must be right are GC_AUTH_SECRET
# (or the runner is open) and PUBLIC_URL (or sign-in 403s).

# How you actually reach the box, exactly as you type it in the browser.
# The UI is BUILT with this, and Django trusts it for CSRF — so if you later
# put DNS or TLS in front, change this and rebuild.
PUBLIC_URL=CHANGE_ME_SCHEME_AND_HOST

# The key the runner and the control plane share. At least 32 characters, and
# the SAME value on both sides — they are read from here by both services.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# There is no default anywhere in the codebase on purpose: a fallback secret is
# one that reaches production unnoticed, because everything keeps working.
GC_AUTH_SECRET=CHANGE_ME_48_RANDOM_BYTES

# Where the Django admin answers. One path segment, no slashes.
#
# On a box reachable from the internet with no TLS, /admin/ is a login form
# anyone can find and sit in front of — there is no lockout here. This moves it
# somewhere nobody will guess and makes /admin/ a 404. That is obscurity rather
# than a control: it removes the box from every scan that walks the well-known
# paths, and it does not survive the path being screenshotted or shared.
#
#   node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
#
GC_ADMIN_PATH=CHANGE_ME_RANDOM_PATH

# Django's own signing key, for sessions and CSRF. Changing it logs everyone out.
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_50_PLUS_RANDOM_CHARS

# Optional --------------------------------------------------------------------
# Set to your hostname once you have one; '*' is acceptable only while the
# security group is the thing keeping strangers out.
DJANGO_ALLOWED_HOSTS=*

# How much of a run is performed for a watcher (docs: GC_PACE_MS). 0 is as fast
# as the page allows; 420 is the laptop default. 250 is a reasonable remote
# middle — brisk, still followable over a screencast.
GC_PACE_MS=250
GC_TIMEOUT_MS=8000
GC_SETTLE_MS=250

# Vault values, if a suite needs them. Named GC_SECRET_<NAME>; the value never
# leaves the server and is redacted out of the forwarded browser console.
# GC_SECRET_QA_PASS=
