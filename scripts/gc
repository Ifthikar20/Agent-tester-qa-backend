#!/usr/bin/env bash
# Every compose command for this stack, with the two flags that are not optional.
#
#   ./scripts/gc logs -f runner
#   ./scripts/gc ps
#   ./scripts/gc exec control python manage.py createsuperuser
#
# Without --env-file, compose cannot interpolate GC_SIGNING_KEY and exits 1
# before doing anything — including for `logs` and `ps`, which need no
# variables at all. That error reads like a broken config file, and it is the
# first thing you hit after a deploy. This wrapper is the fix, and it is why
# docs/DEPLOY.md never spells a compose command out longhand.
#
# It runs as root, through sudo, and that is the point rather than a
# convenience (docs/AUTH.md §12 [ops-supply-1]): .env.prod holds the signing
# key and is root-owned, 0600, so no process running as the deploy user can
# read it; the deploy user is NOT in the docker group, because that group is
# root by another name and nothing logs its use; and every command that
# reaches the daemon goes through one sudoers line, which means every one of
# them is in auth.log with who ran it. bootstrap-ec2.sh and aws-up.sh write
# that line, and it names a file in /usr/local/sbin:
#
#   ubuntu ALL=(root) NOPASSWD:SETENV: /usr/local/sbin/gc
#
# NOT this file. This file lives in the checkout, which the deploy user owns
# and pulls into — so pointing sudo at it made
# \`echo 'cat .env.prod' >> scripts/gc && sudo -n scripts/gc\` a one-line way
# to read the signing key, which is the exact thing [ops-supply-1] is for.
# /usr/local/sbin/gc is root:root 0755, written by the bootstrap before the
# clone exists, and it does the one thing this wrapper's last line does.
#
# WHAT THIS DOES NOT BUY. Compose still reads docker/compose.prod.yml out of
# the checkout, and a compose file can mount any host path into a container:
# a deploy user who can edit that file can still become root the slow way.
# \`gc\` is root-equivalent by design, and the control it establishes is the
# auth.log record of who ran what and the fact that .env.prod itself stays
# unreadable — not confinement. Confining it would mean putting the compose
# file out of the deploy user's reach too, which is a different deployment
# shape than "git pull and run".
#
# SETENV, so GC_GIT_SHA — the one variable the deploy sets in the shell for
# compose to bake into the runner image — survives sudo's environment reset.
# An operator who is root already, or who has put themselves in the docker
# group on a laptop, is not asked twice.
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"
[ -f .env.prod ] || { echo "no .env.prod here ($PWD) — copy .env.prod.example and fill it in" >&2; exit 1; }
if [ "$(id -u)" != 0 ] && ! docker info >/dev/null 2>&1; then
  # -n: never prompt. A deploy is a script, and a script that stops at a
  # password prompt inside an ssh session hangs rather than asks; the
  # sudoers line above is what makes this succeed, and its absence is the
  # message below.
  # No `exec` on this path. exec REPLACES this shell, so when sudo runs and
  # then refuses — the exact case the message below is for — the wrapper is
  # already gone and all the operator sees is sudo's own "a password is
  # required". One extra fork buys the sentence that names the sudoers line.
  sudo -n GC_GIT_SHA="${GC_GIT_SHA:-}" /usr/local/sbin/gc "$@"
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "sudo -n /usr/local/sbin/gc exited $status — is the sudoers line at the top of this file in place?" >&2
  fi
  exit "$status"
fi
exec docker compose -f docker/docker-compose.prod.yml --env-file .env.prod "$@"
