# The case language is hashed, so its line endings are a fact about it.
#
# vocabulary.js and flow.js carry a version number, and `npm run check:shared`
# proves that number still describes their bytes (scripts/copies.js). The
# digest is taken over LF-normalised text — a hash that came out differently on
# Windows would be a check people turn off — and these two lines are the other
# half of that promise: normalisation stays ON for them, so what git stores is
# what the digest was computed from, on every machine.
vocabulary.js text eol=lf
flow.js text eol=lf

# The shell scripts the deployment runs on a Linux host. A CRLF shebang line
# is `/usr/bin/env bash\r`, which is not a program, and the error names a file
# that plainly exists.
*.sh text eol=lf
scripts/gc text eol=lf
docker/Caddyfile text eol=lf
