# Copy to .env (gitignored) or export these before `python manage.py runserver`.
#
# Leave GC_PUBLIC_URL unset and this is the laptop profile: SQLite, an
# in-process cache, mail printed to the console, plain cookies on localhost.
# Set it and everything about hosts, origins and cookies is derived from it,
# and Postgres, Redis and a mail host become required.

# --- this service -----------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Sessions and CSRF are signed with it, so
# changing it logs everyone out.
# DJANGO_SECRET_KEY=
# Laptop only. Ignored once GC_PUBLIC_URL is set; '*' is refused with DEBUG off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- production, derived from one URL --------------------------------------
# How the browser reaches the edge. https://host means Secure, __Host- cookies
# and HSTS at the edge; http://ip works for a demo and is none of those.
# GC_PUBLIC_URL=https://app.example.com
# Postgres. Required when DJANGO_DEBUG=0 (SQLite is refused there).
# DATABASE_URL=postgres://ghostclick:PASSWORD@localhost:5432/ghostclick
# Redis, where the rate limits count. Required when DJANGO_DEBUG=0.
# GC_REDIS_URL=redis://:PASSWORD@localhost:6379/0
# Mail. Console when DEBUG is on; SMTP otherwise, and then EMAIL_HOST is
# required — or name the console backend on purpose for a demo.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=ghostclick <no-reply@app.example.com>

# --- the browser (laptop only) ---------------------------------------------
# Where the UI is served from. Needed for CORS and CSRF because on a laptop
# the SPA is on a different origin than this service. Same value the executor
# is given. In production the UI is the same origin and this is not read.
GC_WEB_ORIGIN=http://localhost:3000

# Only for a UI on a genuinely different site (a static host in front of your
# own API). 'None' requires Secure, so the two move together.
# GC_COOKIE_SAMESITE=None
# GC_COOKIE_SECURE=1

# --- the executor -----------------------------------------------------------
# Shared with the runner, which verifies tokens signed with it. At least 32
# characters, and the SAME value on both sides. No default anywhere: an
# unconfigured service refuses to mint rather than issuing something nobody can
# check.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GC_AUTH_SECRET=
# 60 to 600 seconds. The deploy refuses anything longer.
GC_TOKEN_TTL=600
