# Copy to .env (gitignored) or export these before `python manage.py runserver`.
#
# Leave GC_PUBLIC_URL unset and this is the laptop profile: SQLite, an
# in-process cache, mail printed to the console, plain cookies on localhost.
# Set it and everything about hosts, origins and cookies is derived from it,
# and Postgres, Redis and a mail host become required.

# --- this service -----------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Sessions and CSRF are signed with it, so
# changing it logs everyone out.
# DJANGO_SECRET_KEY=
# Laptop only. Ignored once GC_PUBLIC_URL is set; '*' is refused with DEBUG off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- production, derived from one URL --------------------------------------
# How the browser reaches the edge. https://host means Secure, __Host- cookies
# and HSTS at the edge; http://ip works for a demo and is none of those.
# GC_PUBLIC_URL=https://app.example.com
# Postgres. Required when DJANGO_DEBUG=0 (SQLite is refused there).
# DATABASE_URL=postgres://ghostclick:PASSWORD@localhost:5432/ghostclick
# Redis, where the rate limits count. Required when DJANGO_DEBUG=0.
# GC_REDIS_URL=redis://:PASSWORD@localhost:6379/0
# Mail. Console when DEBUG is on; SMTP otherwise, and then EMAIL_HOST is
# required — or name the console backend on purpose for a demo.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=ghostclick <no-reply@app.example.com>

# --- accounts ---------------------------------------------------------------
# Who may sign up: invite (the default; an address needs a live invitation),
# open (anyone), or domain (exactly the domains in GC_SIGNUP_DOMAINS). On a
# laptop with nobody to invite you, `open` is the one that lets you sign up
# through the page; `adduser` makes an account either way.
# GC_SIGNUP_MODE=invite
# GC_SIGNUP_DOMAINS=acme.example
# Cloudflare Turnstile, both or neither. Open-mode sign-up and any address
# that has tripped the failed-sign-in limit present a token. Unset, nothing
# asks — there is no Cloudflare on a laptop.
# GC_TURNSTILE_SITE_KEY=
# GC_TURNSTILE_SECRET=
# Sign in with Google, both or neither. An OAuth client from the Google Cloud
# console whose authorised redirect URI is <this service's origin>/accounts/
# google/login/callback/ — on a laptop, http://localhost:8000/accounts/google/
# login/callback/ — and whose authorised JavaScript origin is GC_WEB_ORIGIN.
# Unset, there is no Google button and no callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- the browser (laptop only) ---------------------------------------------
# Where the UI is served from. Needed for CORS and CSRF because on a laptop
# the SPA is on a different origin than this service. Same value the executor
# is given. In production the UI is the same origin and this is not read.
GC_WEB_ORIGIN=http://localhost:3000

# Only for a UI on a genuinely different site (a static host in front of your
# own API). 'None' requires Secure, so the two move together.
# GC_COOKIE_SAMESITE=None
# GC_COOKIE_SECURE=1

# The recorder extension's origins, comma-separated, trusted for CSRF and
# CORS so its background worker can be handed an executor token with your
# session (docs/AUTH.md §11). chrome-extension://<id> and nothing else —
# the panel shows the id; an unpacked extension's differs per machine. Give
# the runner the same line (it reads it for CORS). Unset, the extension can
# only Copy mermaid.
# GC_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# --- the executor -----------------------------------------------------------
# The Ed25519 private key executor tokens are signed with. This service holds
# it and nothing else does; the runner is given the PUBLIC half. One command
# prints both, each on one line (a PEM has newlines; here they are written as
# \n, which the single quotes keep literal):
#
#   python manage.py signing_key --new
#
# No default anywhere: an unconfigured service refuses to mint rather than
# issuing something nobody can check, and with DJANGO_DEBUG=0 it refuses to
# start. `npm run app -- --auth` generates one into ../.ghostclick/ for you.
# GC_SIGNING_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# 60 to 600 seconds; anything outside is clamped, and the deploy refuses it.
GC_TOKEN_TTL=600

# --- the second factor ------------------------------------------------------
# The key authenticator-app secrets and recovery codes are encrypted with at
# rest; not DJANGO_SECRET_KEY on purpose. Required when DJANGO_DEBUG=0. On a
# laptop it is derived from the fixed dev secret when unset, so `runserver`
# with nothing set still works; `npm run app -- --auth` keeps one in
# ../.ghostclick/mfa-key and passes it, so an authenticator enrolled there
# stays readable — export the same value when running this by hand. Several
# keys, comma-separated, rotate: the first encrypts, every one decrypts.
#
#   python manage.py mfa_key
# GC_MFA_KEY=
# Where passkey ceremonies happen: the public URL in production, and the
# UI's origin on a laptop (GC_WEB_ORIGIN above) — derived, not set. fido2
# refuses http origins other than localhost, so passkeys need https anywhere
# real; the authenticator app works everywhere.
